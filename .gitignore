# Project-wide .gitignore
# Covers both the talk-prep files (outline/, references/) and the
# workshop-content/ scaffolding. The workshop-content/.gitignore is also
# kept in place so it ships with the public-facing repo on its own.

# --- Node / Bun ---
node_modules/
bun-debug.log
.bun-cache/

# --- Build artifacts ---
dist/
build/
out/
*.tsbuildinfo

# --- Environment / secrets ---
.env
.env.local
.env.*.local

# --- Editor / IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# --- Misc local artifacts ---
*.local
.cache/

# Note: bun.lock IS committed (per-step) for reproducible workshop builds.
# Do NOT add bun.lock or bun.lockb here.
